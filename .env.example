# Copy to .env (gitignored) and fill in. No secrets here: the database uses Entra tokens (W-004).
WHALES_DB_HOST=pg-tocqv-context.postgres.database.azure.com
WHALES_DB_NAME=whales_dev
# For `whales --open-firewall` and `whales db close-firewall` (laptop admin steps only)
WHALES_DB_RESOURCE_GROUP=rg-research-automation
# Locally: leave empty to use your `az login` name. In Azure: the job identity's role name.
WHALES_DB_USER=
# SEC fair-access contact (STATUS.md: confirm the mailbox exists and is read)
SEC_USER_AGENT=Tocqueville Asset Management research@tocqueville.com
# The in-tenant model endpoint (W-052): the OpenAI-compatible base of an approved host (whales.llm) and a
# deployment name on it. Signed in with an Entra token (your az login, or the job identity): no key.
WHALES_MODEL_ENDPOINT=https://tocqv-research-ai.cognitiveservices.azure.com/openai/v1
WHALES_MODEL_DEPLOYMENT=whales-extract
